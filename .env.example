# Telegram API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Optional: Your phone number with international country code (e.g. +1234567890)
TELEGRAM_PHONE=+1234567890

# Channel Username or ID to monitor (e.g. @your_channel_name or -1001234567890)
TARGET_CHANNEL=@your_channel_name

# Execution Mode: 'browser' (Recommended to bypass Cloudflare/Captcha) or 'api'
REDEMPTION_MODE=browser

# Playwright Browser Configuration
HEADLESS=false  # Set to false on initial login so you can log into Binance manually once
USER_DATA_DIR=./user_data  # Directory preserving your logged-in Binance browser cookies
